# Exemple de configuration Nginx pour le déploiement Ubuntu (section 2.6.4).
# À adapter (nom de domaine, chemins, certificats HTTPS) puis copier vers
# /etc/nginx/sites-available/ sur le serveur.

server {
    listen 80;
    server_name club-informatique.example.bf;

    # Assets Angular buildés (frontend/dist/club-informatique-frontend/browser)
    root /var/www/club-informatique/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy vers l'API Spring Boot (port interne 8080)
    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /actuator/health {
        proxy_pass http://127.0.0.1:8080/actuator/health;
    }
}

# HTTPS : une fois le certificat obtenu (ex. certbot), rediriger le port 80
# vers 443 et servir ce bloc en "listen 443 ssl;".
