# ===================================================================
# Variables d'environnement — Club Informatique IST Backend
# ===================================================================
# Copier ce fichier en .env et renseigner les valeurs réelles.
# NE JAMAIS versionner le fichier .env contenant de vraies valeurs.
# ===================================================================

# --- Serveur ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Base de données PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/club_informatique_dev
DB_USERNAME=postgres
DB_PASSWORD=changeme

# --- JWT ---
# Clé secrète pour la signature des tokens JWT (min 64 caractères recommandé)
JWT_SECRET=changeme-to-a-very-long-and-secure-random-string-at-least-64-chars

# --- CORS ---
# Origines autorisées (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@clubinfo.ist
MAIL_PASSWORD=changeme

# --- Upload de fichiers ---
UPLOAD_DIR=./uploads

# --- Premier Super Admin réel ---
# Créé au démarrage tant qu'aucun Super Admin réel n'existe ; mot de passe (12 caractères au moins) à changer à la première connexion.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Comptes de test (essais uniquement) ---
# Un compte par rôle sur le domaine recette.invalid. Laisser à false en production.
APP_SEED_TEST_ACCOUNTS=false
APP_TEST_ACCOUNTS_PASSWORD=
# Retrait des comptes de test et de leurs données au prochain démarrage.
APP_PURGE_TEST_ACCOUNTS=false
