# ===================================================================
# Variables d'environnement — Club Informatique IST Backend
# ===================================================================
# Copier ce fichier en .env et renseigner les valeurs réelles.
# NE JAMAIS versionner le fichier .env contenant de vraies valeurs.
# ===================================================================

# --- Serveur ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Base de données PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/club_informatique_dev
DB_USERNAME=postgres
DB_PASSWORD=changeme

# --- JWT ---
# Clé secrète pour la signature des tokens JWT (min 64 caractères recommandé)
JWT_SECRET=

# --- CORS ---
# Origines autorisées (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Courriel (SMTP) ---
# En développement : serveur de capture local (Mailpit, port 1025), rien ne sort de la machine.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Adresse d'expédition des courriels
MAIL_FROM=ne-pas-repondre@localhost
# Adresse publique du frontend (liens placés dans les courriels)
APP_FRONTEND_URL=http://localhost:4200

# --- Fichiers déposés ---
# local : dossier (volume persistant en ligne) ; s3 : stockage objet compatible S3
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Premier Super Admin réel ---
# Créé au démarrage tant qu'aucun Super Admin réel n'existe ; mot de passe (12 caractères au moins) à changer à la première connexion.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Comptes de test (essais uniquement) ---
# Un compte par rôle sur le domaine recette.invalid. Laisser à false en production.
APP_SEED_TEST_ACCOUNTS=false
APP_TEST_ACCOUNTS_PASSWORD=
# Retrait des comptes de test et de leurs données au prochain démarrage.
APP_PURGE_TEST_ACCOUNTS=false

# --- Contact ---
# Adresse du club qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=clubinformatique.ist@gmail.com
# Cookie de session marqué Secure (à activer dès que le site est servi en HTTPS)
COOKIE_SECURE=false
